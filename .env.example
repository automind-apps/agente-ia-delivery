# ===== CHAVE DA API (obrigatorio, exceto em MOCK) =====
# console.anthropic.com > API Keys. Sem aspas, sem espacos em volta do "=".
ANTHROPIC_API_KEY=sk-ant-cole-sua-chave-aqui

# ===== NUMERO DO CORRETOR (recebe os resumos de lead) =====
# Formato: DDI 55 + DDD + numero, so digitos. Ex: 5519999998888
# Em branco = leads aparecem so no terminal (bom para testar).
CORRETOR_WHATSAPP=

# ===== MODO DE TESTE =====
# true  = nao chama a API (resposta fixa), para testar o WhatsApp de graca
# false = usa a IA de verdade
MOCK=false

# ===== JANELA DE RETOMADA (opcional) =====
# Horas. Se a pessoa volta depois desse tempo, o bot recarrega o contexto
# do banco. Padrao 168 (7 dias). Coloque 24 para "retomar so dentro de 1 dia".
RESUME_WINDOW_HOURS=168

# Apagar o historico antigo do contato ao iniciar nova conversa apos gap longo?
# true = mais privacidade e menos dados guardados. Padrao false.
LIMPAR_HISTORICO_ANTIGO=false
